# Deployment Environment Variables

# Turso Database (for production)
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Vercel
# These are set automatically by Vercel

# Circle
CIRCLE_API_KEY=your-circle-api-key
CIRCLE_APP_ID=your-circle-app-id
ENTITY_SECRET=your-entity-secret

# Meta
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# Google
GOOGLE_ADS_CLIENT_ID=your-google-client-id
GOOGLE_ADS_CLIENT_SECRET=your-google-client-secret

# LLM Providers
OPENAI_API_KEY=your-openai-key
NVIDIA_API_KEY=your-nvidia-key
